<%- include('../port/layout-start', {title: title}) %> <%-
include('../port/menu') %>

<h1><%= title %></h1>
<a class="btn btn-sm btn-primary" href="create">Добавить книгу</a>

<% if(books.length) { %>

<table class="table table-striped table-sm mt-3">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Заголовок</th>
      <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    <% books.map((el, idx) => { %>
    <tr>
      <th scope="row"><%= idx +1 %></th>
      <td><%= el.title %></td>
      <td class="text-right">
        <a class="btn btn-sm btn-success" href="/<%= el.id %>">
          <i class="fa fa-eye" aria-hidden="true"></i>
        </a>
        <a class="btn btn-sm btn-primary" href="/books/update/<%= el.id %>">
          <i class="fa fa-pencil" aria-hidden="true"></i>
        </a>

        <button
          class="btn btn-sm btn-danger"
          id="deleteBtn"
          data-id="<%= el.id %>"
        >
          <i class="fa fa-trash" aria-hidden="true" data-id="<%= el.id %>"></i>
        </button>
      </td>
    </tr>

    <% }) %>
  </tbody>
</table>

<% } else { %>
<h3 class="mt-5">Записей пока нет</h3>
<% } %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const funcDelete = (e) => {
      e.preventDefault();
      const id = e.target.dataset.id;
      console.log(e.target.dataset.id);
      const urlAPI = `${window.location.origin}/api/books/${id}`;

      fetch(urlAPI, {
        method: "DELETE",
      })
        .then((res) => location.reload())

        .catch((error) => {
          console.error("Error:", error);
          alert("An error occurred: " + error);
        });
    };
    document.querySelectorAll(".btn-danger").forEach((el) => {
      el.addEventListener("click", funcDelete);
    });
  });
</script>

<%- include('../port/layout-end') %>
